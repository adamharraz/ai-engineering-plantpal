        <mxCell id="C2" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;C2  Application controls&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Owner access + scope&lt;br&gt;Photo consent / EXIF removal&lt;br&gt;Screen before AI calls&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR1-FR3, FR9-FR10, RAI4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e8;strokeColor=#c07b35;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172b45;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1">
