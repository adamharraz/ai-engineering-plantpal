        <mxCell id="C4" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C4  AI capability&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Language-model service&lt;br&gt;Screened query + evidence&lt;br&gt;Draft cited explanation&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;FR1, FR6, NFR1, RAI5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eef4ff;strokeColor=#527fb9;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
