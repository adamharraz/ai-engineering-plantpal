        <mxCell id="C3" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C3  Knowledge access&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match scheme / intake&lt;br&gt;Local degree pathway&lt;br&gt;Up to 5 cited passages&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;FR1, FR2, NFR2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eef4ff;strokeColor=#527fb9;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
