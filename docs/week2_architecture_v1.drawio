<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="plantpal-v1-simple" name="PlantPal V1">
    <mxGraphModel dx="2240" dy="1490" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1490" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PlantPal" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=44;fontStyle=1;fontColor=#143b32;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="2100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="V1 conceptual architecture | Seven main components | Proposed design, not implemented" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#475569;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="2100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="C0" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C0  User&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Beginner plant owner&lt;br&gt;Photo / question&lt;br&gt;Confirm care actions&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;Intended user&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#8a99ac;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="50" y="535" width="240" height="230" as="geometry" />
        </mxCell>
        <mxCell id="C1" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C1  Web application&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload / preview / confirm plant&lt;br&gt;My Plants / care history / settings&lt;br&gt;Input checks + private user access&lt;br&gt;Show answers and due care checks&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR1-FR10 | RAI1, RAI3-RAI6&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e8;strokeColor=#c07b35;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="430" y="500" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C2  Plant identification AI&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Consented photo input&lt;br&gt;Ranked plant-name suggestions&lt;br&gt;User confirms the result in C1&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR1-FR2 | NFR1, NFR3&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#527fb9;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="1120" y="170" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C3  Reviewed care documents&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three Malaysian care guides&lt;br&gt;Approved passages + care notes&lt;br&gt;Source links and species context&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR4, FR8, FR11 | RAI2&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#edf8f1;strokeColor=#438264;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="1720" y="530" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="C4" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C4  AI care assistant&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Find relevant approved passages&lt;br&gt;Explain care and check citations&lt;br&gt;Answer OR explain missing evidence&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR8-FR9 | NFR2 | RAI2, RAI6&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#527fb9;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="1120" y="530" width="430" height="240" as="geometry" />
        </mxCell>
        <mxCell id="C5" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C5  Plant collection database&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Private saved plants + care history&lt;br&gt;Approved reminder settings&lt;br&gt;Consent and due-event records&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR3, FR5-FR7, FR10 | RAI4&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#edf8f1;strokeColor=#438264;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="430" y="1040" width="450" height="240" as="geometry" />
        </mxCell>
        <mxCell id="C6" value="&lt;b&gt;&lt;font style=&quot;font-size:25px&quot;&gt;C6  Scheduler + email&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Runs when the browser is closed&lt;br&gt;Recheck consent; send once&lt;br&gt;Opt-in care CHECK reminders&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR5-FR7 | NFR4 | RAI5&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#edf8f1;strokeColor=#438264;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b45;align=center;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1040" width="430" height="240" as="geometry" />
        </mxCell>
        <mxCell id="privacy-note" value="&lt;b&gt;Checks inside C1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ask for photo consent; remove location metadata before AI calls.&lt;br&gt;Confirm a supported plant before care setup; saving stays optional.&lt;br&gt;Check ownership and scope; keep email addresses out of AI input." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#955a1c;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="review-note" value="&lt;b&gt;Source review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Review nursery advice before use.&lt;br&gt;Keep source IDs and approved passages.&lt;br&gt;Two PDFs support checking / lab prep;&lt;br&gt;they are not automatically searchable." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#237046;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1720" y="170" width="440" height="230" as="geometry" />
        </mxCell>
        <mxCell id="care-note" value="&lt;b&gt;Care reminder rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ask users to check conditions first.&lt;br&gt;Users can snooze, pause or turn off.&lt;br&gt;AI cannot change records or send email." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#475569;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1720" y="820" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-note" value="&lt;b&gt;Evaluation - offline checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;Test photos, answers and citations.&lt;br&gt;Check privacy and reminder behaviour.&lt;br&gt;Measure response time and cost.&lt;br&gt;Use safe test data; no raw live logs.&lt;br&gt;O3 | EC01-EC14" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#75559d;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1040" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="user-app" value="use app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52708f;fontFamily=Arial;fontSize=18;fontColor=#52708f;labelBackgroundColor=#ffffff;jumpStyle=arc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="C0" target="C1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="identify" value="Photo / suggestions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52708f;fontFamily=Arial;fontSize=18;fontColor=#52708f;labelBackgroundColor=#ffffff;jumpStyle=arc;exitX=0.5;exitY=0;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="C1" target="C2">
          <mxGeometry relative="1" as="geometry">
