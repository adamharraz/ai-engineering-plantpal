        <mxCell id="due-state" value="Due items / status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#438264;fontFamily=Arial;fontSize=18;fontColor=#438264;labelBackgroundColor=#ffffff;jumpStyle=arc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="C5" target="C6">
          <mxGeometry relative="1" as="geometry" />
