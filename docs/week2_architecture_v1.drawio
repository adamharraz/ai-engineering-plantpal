        <mxCell id="C3" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;C3  Image identification&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pre-trained AI capability&lt;br&gt;Ranked names + scores&lt;br&gt;Uncertain / failed result&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR1, NFR1, NFR3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eef4ff;strokeColor=#527fb9;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172b45;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1">
