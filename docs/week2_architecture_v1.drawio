        <mxCell id="C2" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C2  Input controls&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Scope + missing context&lt;br&gt;Apparent private data&lt;br&gt;Screen before AI calls&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;FR3, FR4, RAI2, RAI3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff4e8;strokeColor=#c07b35;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
