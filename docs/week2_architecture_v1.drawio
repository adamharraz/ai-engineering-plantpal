        <mxCell id="C0" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C0  Learner&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Malaysian student&lt;br&gt;English question&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;Intended user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f1f5f9;strokeColor=#8a99ac;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
