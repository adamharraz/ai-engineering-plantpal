        <mxCell id="care-chat" value="Question / answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52708f;fontFamily=Arial;fontSize=18;fontColor=#52708f;labelBackgroundColor=#ffffff;jumpStyle=arc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="C1" target="C4">
          <mxGeometry relative="1" as="geometry" />
