        <mxCell id="C5" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C5  Answer checks&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Source IDs + metadata&lt;br&gt;Scope / format checks&lt;br&gt;Withhold unsupported drafts&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;FR2, FR6, RAI1, RAI2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff4e8;strokeColor=#c07b35;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
