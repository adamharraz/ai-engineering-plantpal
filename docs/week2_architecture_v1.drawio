        <mxCell id="C7" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C7  Official documents&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khazanah Watan / YTAR&lt;br&gt;YTN PRIME: local pathways&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;FR1, FR5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#edf8f1;strokeColor=#438264;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
