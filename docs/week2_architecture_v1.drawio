        <mxCell id="care-notes" value="approved care notes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#438264;fontFamily=Arial;fontSize=18;fontColor=#438264;labelBackgroundColor=#ffffff;jumpStyle=arc;exitX=0.5;exitY=0;entryX=0.8;entryY=0;" edge="1" parent="1" source="C3" target="C1">
