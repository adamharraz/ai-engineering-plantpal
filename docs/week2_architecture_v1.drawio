        <mxCell id="C1" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;C1  Web interface&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preview + candidate review&lt;br&gt;My Plants / care history&lt;br&gt;Due list + cited chat&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR1-FR10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f1f5f9;strokeColor=#8a99ac;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172b45;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1">
