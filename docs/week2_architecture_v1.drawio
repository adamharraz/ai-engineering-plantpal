        <mxCell id="C4" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;C4  Confirmation + care rules&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirm supported species&lt;br&gt;Explicit Add / care actions&lt;br&gt;Approve editable intervals&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#475569&quot;&gt;FR2, FR4-FR6, RAI1, RAI3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e8;strokeColor=#c07b35;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172b45;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1">
