        <mxCell id="email-user" value="Opt-in email care checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#438264;fontFamily=Arial;fontSize=18;fontColor=#438264;labelBackgroundColor=#ffffff;jumpStyle=arc;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="C6" target="C0">
