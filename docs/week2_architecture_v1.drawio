        <mxCell id="C8" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;C8  Reviewed source catalogue&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maintainer selects permitted sections&lt;br&gt;Scheme, intake, pathway + provenance&lt;br&gt;Activate a reviewed source release&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#475569&quot;&gt;FR5, NFR5, RAI1, RAI5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#edf8f1;strokeColor=#438264;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172b45;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
